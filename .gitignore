# Rust build/cache roots. Keep root-anchored so source directories named
# "target" are not hidden.
/target/
# #2161 — the crates share one workspace target dir. The per-crate entries that
# used to sit here covered the standalone builds each path crate then had.
/src-tauri/target/
**/*.rs.bk
*.pdb

# Node
/node_modules/
/dist/
/.vite/

# E2E cache mount (CI: actions/cache restores into here; local dev: ignore)
/cargo-target/

# Environment
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code (local-only)
.claude/settings.local.json
.claude/org.settings.local.json
# Claude Code sub-agent git worktrees. Untracked by design — also gitignored so
# Tailwind v4's `@tailwindcss/vite` source-scanner (which respects .gitignore)
# doesn't walk into them and resolve sibling `<img src="...">` paths against
# stale worktree roots.
/.claude/worktrees/
# 둘 다 방어용이다 — 작업 사본의 규약 위치는 repo **밖** 형제 디렉토리
# `../table-view-clones/` 이고 (2026-07-31 #2035 결정 7,
# memory/runbook/worktree/memory.md), 여기 걸리는 건 repo 안에 실수로 사본을
# 만들었을 때뿐이다. .gitignore 로는 rg · Tailwind source scan · lint 글롭까지
# 막지 못하므로 이 항목을 믿고 repo 안에 두지 마라.
# `/worktrees/`: linked worktree 를 쓰던 옛 규약의 잔재 (clone 으로 대체됨).
/worktrees/
/clones/

# Test
/coverage/
# vitest `--reporter=blob` output. Written by the CI `Frontend Tests (shard n/3)`
# matrix and by any local `vitest --shard` run reproducing it; the merge step
# consumes it. ~8MB per shard on disk (1.6-1.9MB zipped as a CI artifact).
/.vitest-reports/
# Anchor `wdio-report/` to the repo root so the e2e bind-mount target
# (`e2e/wdio-report/`) can preserve its `.gitkeep` (sprint-169 Sprint 4).
/wdio-report/
/e2e/wdio-report/*
!/e2e/wdio-report/.gitkeep
/test-results/

# Build
*.tsbuildinfo

# tmp
/tmp/

# Local-only evaluation/plan drafts
docs/ui-evaluation.md
docs/ui-evaluation-results.md
docs/ui-fixes-plan.md

# sprint-175 startup measurement trial logs (regenerated locally)
.startup-trials/

# Icon build artifacts — actool rewrites partial-info.plist on every icon
# rebuild. The .car/.icns siblings ARE committed, so dev/CI builds don't
# require local Xcode + librsvg.
src-tauri/icons/Compiled/partial-info.plist
